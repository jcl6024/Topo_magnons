     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Beta]", "[", 
          RowBox[{"n", "+", "1"}], "]"}], "==", 
         RowBox[{
          RowBox[{"\[Beta]", "[", "n", "]"}], "+", 
          RowBox[{"3", 
           RowBox[{"KroneckerDelta", "[", 
            RowBox[{"0", ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"n", ",", "4"}], "]"}]}], "]"}]}]}]}], ",", 
