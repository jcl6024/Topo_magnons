Cell[CellGroupData[{

Cell["MANR-SQ Coupling", "Section",
 CellChangeTimes->{{3.976295294725082*^9, 3.9762952996308603`*^9}, {
  3.976296896081024*^9, 
  3.9762969043109846`*^9}},ExpressionUUID->"67c3e7f2-810e-5a4f-bf66-\
6373d91a2b02"],

Cell[CellGroupData[{

Cell["Wavefunction Algorithm (must run)", "Subsection",
 CellChangeTimes->{{3.976296911279978*^9, 
  3.9762969172684364`*^9}},ExpressionUUID->"cf4d08db-414f-3a48-b3fc-\
a8cfe6bf7363"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WaveAlgo", "[", 
    RowBox[{
    "J_", ",", "J2_", ",", "DM_", ",", "s_", ",", "\[Kappa]_", ",", 
     "\[CapitalDelta]\[Kappa]_", ",", "h_", ",", "\[Phi]_", ",", "Num_", ",", 
     "Naux_", ",", "upperbound_", ",", "lowerbound_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N0", "=", "Num"}], ",", 
       RowBox[{"NBand", "=", "Naux"}], ",", "A", ",", "H", ",", "sortorder", 
       ",", "BandIndices"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Xi]", "=", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "Pi"}], "3"], "+", 
           RowBox[{"j", "*", " ", 
            RowBox[{"N", "[", 
             FractionBox[
              RowBox[{"2", 
               FractionBox["Pi", "3"]}], "Naux"], "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"H", "=", 
          RowBox[{"MANRMatrix2N", "[", 
           RowBox[{
           "J", ",", "J2", ",", "DM", ",", "s", ",", "\[Kappa]", ",", 
            "\[CapitalDelta]\[Kappa]", ",", "h", ",", "\[Phi]", ",", "\[Xi]", 
            ",", "Num"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"A", "=", 
          RowBox[{"Eigensystem", "[", "H", "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"sortorder", "=", 
          RowBox[{"Ordering", "[", 
           RowBox[{"A", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"f", "[", "\[Xi]", "]"}], "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Xi]", " ", ",", 
              FractionBox[
               RowBox[{
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "[", 
                 RowBox[{"[", "sortorder", "]"}], "]"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"2", "Pi", " ", "\[HBar]"}]]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"2", "Num"}]}], "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "Naux"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Fun", "[", "l_", "]"}], ":=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", "\[Xi]", "]"}], "[", 
            RowBox[{"[", "l", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Xi]", ",", 
             RowBox[{"-", 
              FractionBox["Pi", "3"]}], ",", 
             FractionBox["Pi", "3"], ",", 
             RowBox[{"N", "[", 
              FractionBox[
               RowBox[{"2", 
                FractionBox["Pi", "3"]}], "Naux"], "]"}]}], "}"}]}], "]"}]}], 
        ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Iterates", " ", "through", " ", "table", " ", "of", " ", "values", 
        " ", "to", " ", "grab", " ", "indices", " ", "which", " ", "coincide",
         " ", "to", " ", "bands", " ", "within", " ", "desired", " ", 
        "bounds"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"FindIndices", "[", 
        RowBox[{"NBand_", ",", "N0_", ",", "ub_", ",", "lb_"}], "]"}], ":=", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"EmptyList", ",", "Indices"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"EmptyList", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"lb", "<", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"f", "[", "\[Xi]", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Xi]", ",", 
                    RowBox[{"-", 
                    FractionBox["Pi", "3"]}], ",", 
                    FractionBox["Pi", "3"], ",", 
                    RowBox[{"N", "[", 
                    FractionBox[
                    RowBox[{"2", 
                    FractionBox["Pi", "3"]}], "NBand"], "]"}]}], "}"}]}], 
                   "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "<", "ub"}], ",", " ", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"EmptyList", ",", "i"}], "]"}]}], "]"}], 
              "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"f", "[", "\[Xi]", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\[Xi]", ",", 
                    RowBox[{"-", 
                    FractionBox["Pi", "3"]}], ",", 
                    FractionBox["Pi", "3"], ",", 
                    RowBox[{"N", "[", 
                    FractionBox[
                    RowBox[{"2", 
                    FractionBox["Pi", "3"]}], "NBand"], "]"}]}], "}"}]}], 
                  "]"}], "]"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"2", "N0"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Indices", "=", 
           RowBox[{"DeleteDuplicates", "[", "EmptyList", "]"}]}], ";", 
          "\[IndentingNewLine]", "Indices"}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"BandIndices", "=", 
       RowBox[{"FindIndices", "[", 
        RowBox[{"Naux", ",", "Num", ",", "upperbound", ",", "lowerbound"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "k", " ", "value", " ", "and", " ", "corresponding", " ", 
        "band", " ", "index", " ", "for", " ", "a", " ", "fixed", " ", 
        "energy"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"FindMom", "[", 
        RowBox[{"\[Omega]_", ",", "err_"}], "]"}], ":=", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"EmptyList", ",", "Mom"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"EmptyList", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Omega]", "-", "err"}], "<", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"f", "[", "\[Xi]", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"BandIndices", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"\[Xi]", ",", 
                    RowBox[{"-", 
                    FractionBox["Pi", "3"]}], ",", 
                    FractionBox["Pi", "3"], ",", 
                    RowBox[{"N", "[", 
                    FractionBox[
                    RowBox[{"2", 
                    FractionBox["Pi", "3"]}], "Naux"], "]"}]}], "}"}]}], 
                   "]"}], "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "<", 
                 RowBox[{"\[Omega]", "+", "err"}]}], ",", " ", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"EmptyList", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"BandIndices", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
