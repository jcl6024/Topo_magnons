        "INPUTS", ";", "\[IndentingNewLine]", 
        RowBox[{"\[Omega]", ":", " ", 
         RowBox[{"SQ", " ", "frequency"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"k", ":", " ", 
         RowBox[{"resonant", " ", "magnon", " ", "momentum"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"should", " ", "be", " ", "found", " ", "via", " ", 
         RowBox[{"MeanMom", "[", "]"}], " ", "or", " ", "otherwise"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"band", ":", " ", 
