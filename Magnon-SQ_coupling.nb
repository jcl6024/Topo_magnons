       RowBox[{
       "J1", ",", "J2", ",", "s", ",", "DM", ",", "h", ",", "\[Kappa]", ",", 
        "\[CapitalDelta]\[Kappa]", ",", "\[Xi]", ",", "\[Phi]", ",", "N0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
