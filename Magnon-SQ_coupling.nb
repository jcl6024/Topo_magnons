               FractionBox["Pi", "3"], ",", 
               RowBox[{"N", "[", 
                FractionBox[
                 RowBox[{"2", 
                  FractionBox["Pi", "3"]}], "Naux"], "]"}]}], "}"}]}], 
            "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
