Cell[CellGroupData[{

Cell["Range of frequencies", "Subsection",
 CellChangeTimes->{{3.976390612647505*^9, 3.9763906148468857`*^9}, 
   3.976391563478071*^9},ExpressionUUID->"c9ab52b6-8a27-ef45-a05d-\
cc9adf965c1c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CouplingList", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Omega]", "=", 
      RowBox[{"2.9", "+", 
       FractionBox["\[Kappa]", 
        RowBox[{"2", "Pi", " ", "\[HBar]"}]], "+", "i"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MomList", "=", 
      RowBox[{"MeanMom", "[", 
       RowBox[{"\[Omega]", ",", 
        FractionBox["1", "50"]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "MomList", "]"}], ">", "2"}], ",", 
       RowBox[{"MomList", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"MomList", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", 
              FractionBox[
               RowBox[{"Length", "[", "MomList", "]"}], "2"]}], "]"}], "]"}], 
           "]"}], ",", 
          RowBox[{"Mean", "[", 
           RowBox[{"MomList", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"Length", "[", "MomList", "]"}], "2"], "+", "1"}], ";;", 
              RowBox[{"Length", "[", "MomList", "]"}]}], "]"}], "]"}], 
           "]"}]}], "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"band", "=", 
         RowBox[{
          RowBox[{"MomList", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"k", "=", 
         RowBox[{
          RowBox[{"MomList", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"U", "=", 
         RowBox[{"UMatrixMZNR", "[", 
          RowBox[{
          "J", ",", "J2", ",", "DM", ",", "s", ",", "\[Kappa]", ",", 
           "\[CapitalDelta]\[Kappa]", ",", "h", ",", "\[Phi]", ",", "k", ",", 
           "Num"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"x", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"d", "=", "12.5"}], ";", "\[IndentingNewLine]", 
        RowBox[{"NSteps", "=", "102"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Numx", "=", "300"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Rlist", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"RZ", "[", 
            RowBox[{"0", ",", "m", ",", 
             RowBox[{"2", "Num"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "1", ",", 
             RowBox[{"2", "Num"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"xlist", "=", 
         RowBox[{"Rlist", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ylist", "=", 
         RowBox[{"Rlist", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"g", "[", "y_", "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "g", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"g", "=", 
             RowBox[{"Norm", "[", 
              RowBox[{"gMZNR", "[", 
               RowBox[{
               "\[Omega]", ",", "k", ",", "band", ",", "U", ",", "Numx", ",", 
                "Num", ",", "x", ",", "y", ",", "d", ",", "xlist", ",", 
                "ylist"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            "g"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Coupling", "=", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{"g", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "15"}], "+", 
              RowBox[{"j", "*", 
               RowBox[{"N", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    FractionBox["3", "2"], 
                    RowBox[{"(", 
                    RowBox[{"Num", "-", "1"}], ")"}]}], "+", "30"}], ")"}], 
                 "/", "NSteps"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "0", ",", "NSteps"}], "}"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"CouplingList", ",", "Coupling"}], "]"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "[", "MomList", "]"}]}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "0.3", ",", "0.025"}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9763906295044594`*^9, 3.976390677478554*^9}, {
   3.9763908418954678`*^9, 3.976390842133484*^9}, {3.9763987501227055`*^9, 
