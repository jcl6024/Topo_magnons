      ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], " ", 
       RowBox[{"a", "^", "3"}], " ", "h"}], ")"}]}], "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "3"}]}]}]}], ";"}], "\n", 
