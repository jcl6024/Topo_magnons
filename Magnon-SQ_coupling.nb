          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Find", " ", "k", " ", "value", " ", "and", " ", "corresponding", 
          " ", "band", " ", "index", " ", "for", " ", "a", " ", "fixed", " ", 
          "energy"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FindMom", "[", 
