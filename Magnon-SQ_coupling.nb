            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"Indices", "=", 
             RowBox[{"DeleteDuplicates", "[", "EmptyList", "]"}]}], ";", 
            "\[IndentingNewLine]", "Indices"}]}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"BandIndices", "=", 
