      RowBox[{"(*", "eigenvalues", "*)"}], 
      RowBox[{"sortorders", "=", 
       RowBox[{"Ordering", "[", "dumH", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
       "This", " ", "orders", " ", "the", " ", "eigenvalues", " ", "and", " ",
         "eigenfunctions", " ", "accordingly"}], "*)"}], 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Xi]", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"dumH", "[", 
             RowBox[{"[", "sortorders", "]"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi", " ", "\[HBar]"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
