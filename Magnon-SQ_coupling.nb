Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MZNRMatrix2N", "[", 
    RowBox[{
    "J_", ",", "J2_", ",", "DMI_", ",", "S_", ",", "\[Kappa]_", ",", 
     "\[CapitalDelta]\[Kappa]_", ",", "h_", ",", "\[Phi]_", ",", "\[Xi]_", 
     ",", "Num_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H", ",", 
       RowBox[{"N0", "=", "Num"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"H", "=", 
       RowBox[{"ZeroMatrix2N", "[", "N0", "]"}]}], ";", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Note", " ", "that", " ", "the", " ", 
        RowBox[{"Quiet", "[", "]"}], " ", "is", " ", "there", " ", "so", " ", 
        "that", " ", "the", " ", "code", " ", 
        RowBox[{"doesn", "'"}], "t", " ", "throw", " ", "any", " ", "errors", 
        " ", "\[IndentingNewLine]", "about", " ", "trying", " ", "to", " ", 
        "define", " ", "matrix", " ", "elements", " ", "with", " ", "indices",
         " ", "greater", " ", "than", " ", "2", "N"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"H", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"-", "J"}], " ", "S", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["E", 
                   RowBox[{"\[ImaginaryI]", " ", "\[Xi]", 
                    RowBox[{
                    SqrtBox["3"], " ", "/", "2"}]}]], "+", 
                  RowBox[{"Conjugate", "[", 
                   SuperscriptBox["E", 
                    RowBox[{"\[ImaginaryI]", " ", "\[Xi]", " ", 
                    RowBox[{
                    SqrtBox["3"], "/", "2"}]}]], "]"}]}], " ", ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  FractionBox["1", "2"], "+", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 
                    RowBox[{"i", "-", "1"}]], 
                   FractionBox["1", "2"]}]}], ")"}]}], "+", 
               RowBox[{"(", 
                RowBox[{
                 FractionBox["1", "2"], "+", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "i"], 
                  FractionBox["1", "2"]}]}], ")"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"H", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "1"}], ",", "i"}], "]"}], "]"}], "=", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"H", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"i", "+", "2"}]}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"-", 
              SqrtBox[
               RowBox[{
                SuperscriptBox["DMI", "2"], "+", 
                SuperscriptBox["J2", "2"], " "}]]}], "S", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SuperscriptBox["E", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 
                   RowBox[{"i", "-", "1"}]], "\[ImaginaryI]", " ", 
                  "\[Phi]"}]], 
                SuperscriptBox["E", 
                 RowBox[{"\[ImaginaryI]", " ", "\[Xi]", 
                  RowBox[{
                   SqrtBox["3"], " ", "/", "2"}]}]]}], "+", 
               RowBox[{"Conjugate", "[", 
                RowBox[{
                 SuperscriptBox["E", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 
                    RowBox[{"i", "-", "1"}]], "\[ImaginaryI]", " ", 
                   "\[Phi]"}]], 
                 SuperscriptBox["E", 
                  RowBox[{"\[ImaginaryI]", " ", "\[Xi]", 
                   RowBox[{
                    SqrtBox["3"], " ", "/", "2"}]}]]}], "]"}]}], ")"}]}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"H", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"i", "+", "2"}], ",", "i"}], "]"}], "]"}], "=", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"H", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"i", "+", "2"}]}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"H", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
            RowBox[{
             RowBox[{"3", "J", " ", "S"}], "+", 
             RowBox[{"6", "J2", " ", "S"}], "+", "h", "+", "\[Kappa]", "-", 
             RowBox[{
              SqrtBox[
               RowBox[{
                SuperscriptBox["DMI", "2"], "+", 
                SuperscriptBox["J2", "2"], " "}]], " ", "S", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["E", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "i"], "\[ImaginaryI]", " ", 
                   "\[Phi]"}]], 
                 SuperscriptBox["E", 
                  RowBox[{"\[ImaginaryI]", 
                   SqrtBox["3"], " ", "\[Xi]", " "}]]}], "+", 
                RowBox[{"Conjugate", "[", 
                 RowBox[{
                  SuperscriptBox["E", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "i"], "\[ImaginaryI]", " ", 
                    "\[Phi]"}]], 
                  SuperscriptBox["E", 
                   RowBox[{"\[ImaginaryI]", " ", 
                    SqrtBox["3"], "\[Xi]", " "}]]}], "]"}]}], ")"}]}], "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], 
               RowBox[{"i", "-", "1"}]], "\[CapitalDelta]\[Kappa]", " ", 
              "S"}]}]}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"2", "N0"}]}], "}"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Onsite", " ", "edge", " ", "effects"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
        RowBox[{"J", " ", "S"}], "-", 
        RowBox[{"2", "J2", " ", "S"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"2", "J2", " ", "S"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{
           RowBox[{"2", "N0"}], "-", "1"}], ",", 
          RowBox[{
           RowBox[{"2", "N0"}], "-", "1"}]}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"H", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "N0"}], "-", "1"}], ",", 
           RowBox[{
            RowBox[{"2", "N0"}], "-", "1"}]}], "]"}], "]"}], "-", 
        RowBox[{"2", "J2", " ", "S"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
