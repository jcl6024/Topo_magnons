Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Zbasis", "[", "m_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        SqrtBox["3"], "2"], ",", "0"}], "}"}], 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "4"}], "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["1", "2"]}], "}"}], 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"2", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "4"}], "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       FractionBox["3", "2"]}], "}"}], 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"3", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "4"}], "]"}]}], "]"}]}], "+", 
