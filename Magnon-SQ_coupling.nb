      "H"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UMatrixMZNR", "[", 
   RowBox[{
   "J1_", ",", "J2_", ",", "DM_", ",", "s_", ",", "\[Kappa]_", ",", 
