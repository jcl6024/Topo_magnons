          "resonant", " ", "magnon", " ", "momentum"}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"should", " ", "be", " ", "found", " ", "via", " ", 
         RowBox[{"MeanMom", "[", "]"}], " ", "or", " ", "otherwise"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"U", ":", " ", 
         RowBox[{"unitary", " ", "transformation", " ", 
          RowBox[{"matrix", ".", " ", "Rows"}], " ", "correspond", " ", "to", 
          " ", "eigensates"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Numx", ":", " ", 
         RowBox[{
         "number", " ", "of", " ", "spins", " ", "in", " ", "x", " ", 
          "direction", " ", 
          RowBox[{"(", 
           RowBox[{"non", "-", "periodic"}], ")"}], " ", "for", " ", "single",
           " ", 
          RowBox[{"species", "!"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Numy", ":", " ", 
         RowBox[{
         "number", " ", "of", " ", "unit", " ", "cells", " ", "in", " ", "y", 
          " ", "direction", " ", 
          RowBox[{"(", 
           RowBox[{"periodic", ",", " ", 
            RowBox[{
            "should", " ", "be", " ", "much", " ", "greater", " ", "than", 
             " ", "Numx"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", "x"}], 
       ",", "y", ",", 
       RowBox[{
        RowBox[{"z", ":", " ", 
         RowBox[{"coordinates", " ", "of", " ", "SQ"}]}], ";", 
        "\[IndentingNewLine]", "xlist"}], ",", 
       RowBox[{"ylist", ":", " ", 
        RowBox[{
        "vectors", " ", "of", " ", "size", " ", "2", "Numx", " ", 
         "corresponding", " ", "to", " ", "the", " ", "positions", " ", "of", 
         " ", "all", " ", "points", " ", "within", " ", "the", " ", "unit", 
