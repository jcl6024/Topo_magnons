 RowBox[{
  RowBox[{
   RowBox[{"gMANR", "[", 
    RowBox[{
    "\[Omega]_", ",", "k_", ",", "band_", ",", "U_", ",", "Numx_", ",", 
     "Numy_", ",", "x_", ",", "y_", ",", "z_", ",", "xlist_", ",", "ylist_"}],
     "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", "G", ",", "x1", ",", "y1", ",", "z1"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
         "Return", " ", "value", " ", "of", " ", "dipole", " ", "coupling", 
          " ", "for", " ", "MANR"}], "-", 
