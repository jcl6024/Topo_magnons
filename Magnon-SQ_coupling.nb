       FractionBox[
        SqrtBox["3"], "2"], ",", "2"}], "}"}], 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "4"}], "]"}]}], "]"}]}]}]}], 
