Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "table", " ", "of", " ", "values"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Kappa]", "=", "0.3"}], ";", "\[IndentingNewLine]", 
    RowBox[{"\[CapitalDelta]\[Kappa]", "=", "0.05"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Naux", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Num", "=", "35"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"upperbound", "=", "3.4"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lowerbound", "=", "1.8"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WaveAlgoZ", "[", 
      RowBox[{
      "J_", ",", "J2_", ",", "DM_", ",", "s_", ",", "\[Kappa]_", ",", 
       "\[CapitalDelta]\[Kappa]_", ",", "h_", ",", "\[Phi]_", ",", "Num_", 
       ",", "Naux_", ",", "upperbound_", ",", "lowerbound_"}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N0", "=", "Num"}], ",", 
         RowBox[{"NBand", "=", "Naux"}], ",", "A"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"diagonalizes", " ", "hamiltonian", " ", "eigensystem"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "=", 
            RowBox[{
             FractionBox[
              RowBox[{"-", "Pi"}], 
              SqrtBox["3"]], "+", 
             RowBox[{"j", "*", " ", 
              RowBox[{"N", "[", 
               FractionBox[
                RowBox[{"2", 
                 FractionBox["Pi", 
                  SqrtBox["3"]]}], "Naux"], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"H", "=", 
            RowBox[{"MZNRMatrix2N", "[", 
             RowBox[{
             "J", ",", "J2", ",", "DM", ",", "s", ",", "\[Kappa]", ",", 
              "\[CapitalDelta]\[Kappa]", ",", "h", ",", "\[Phi]", ",", 
