Cell[BoxData[{
 RowBox[{
  RowBox[{
  "SetDirectory", "[", 
   "\"\<C:\\\\Users\\\\jeffc\\\\Documents\\\\topo_magnons\\\\MANR_g_v_omega\>\
\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CouplingListAll", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Import", "[", "#", "]"}], "&"}], "/@", 
    RowBox[{"FileNames", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TotalCoupling", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"CouplingListAll", "[", 
       RowBox[{"[", "j", "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "CouplingListAll", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["s", "Numy"], "]"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "\[Mu]B"}], ")"}], "^", "2"}], " ", "\[Mu]0"}], 
      ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"Sqrt", "[", "2", "]"}], " ", 
       RowBox[{"a", "^", "3"}], " ", "h"}], ")"}]}], "*", 
    RowBox[{"10", "^", 
     RowBox[{"-", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxG", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"A", "*", 
       RowBox[{"TotalCoupling", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "TotalCoupling", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Omegas", "=", 
   RowBox[{"DeleteElements", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"2.15", ",", "3.2", ",", "0.01"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"2.72", ",", "2.73", ",", "3.05", ",", "3.06", ",", "3.2"}], 
      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxList", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Omegas", ",", "MaxG"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "2", "}"}], ",", 
       RowBox[{"{", "1", "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
